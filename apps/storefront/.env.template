# Copy to .env.local (gitignored) and fill in. Only the publishable key is
# required; everything else has a default or hides its feature when unset.

# Publishable API key for the Medusa backend. Required for the storefront to function.
# Create or copy one in Medusa Admin -> Settings -> Publishable API Keys (the
# initial seed creates "Default Publishable API Key"). See docs/SETUP.md.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# URL of the Medusa backend API server (dev: http://localhost:9000)
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Base URL of the storefront, used for absolute URLs, the sitemap and robots.txt
# (dev: http://localhost:8000; production: the real https domain).
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Minimum order value in INR, shown as a checkout message. Must match the
# backend's MIN_ORDER_VALUE_INR — this is UX feedback only, not the real
# enforcement. Leave unset (or 0) to disable — no minimum.
NEXT_PUBLIC_MIN_ORDER_VALUE_INR=

# The business's own UPI ID and display name, used to render the UPI payment
# QR on the order-confirmation page. Leave NEXT_PUBLIC_UPI_VPA unset to hide
# the UPI payment step entirely.
NEXT_PUBLIC_UPI_VPA=
NEXT_PUBLIC_UPI_PAYEE_NAME=

# Business details shown in the footer and on the grievance page. Each is shown
# only when set; fill them in before launch (see docs/LAUNCH-CHECKLIST.md).
NEXT_PUBLIC_SITE_LEGAL_NAME=
NEXT_PUBLIC_SITE_GSTIN=
NEXT_PUBLIC_SITE_ADDRESS=

# Phone OTP delivery: leave unset for "server" (the backend generates the code;
# with no MSG91 keys it is printed in the backend console, which is what you
# want in development) or set to "firebase" (Firebase Phone Auth). Must match
# the backend's PHONE_OTP_PROVIDER. See docs/ARCHITECTURE.md section 3.1.
NEXT_PUBLIC_PHONE_OTP_PROVIDER=

# Firebase web-app config, only for "firebase" mode. Firebase console ->
# Project settings -> Your apps. These are public values, not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Medusa Cloud S3 bucket hostname and path (optional, only for Medusa Cloud
# deployments; used to allow product images from that bucket).
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
