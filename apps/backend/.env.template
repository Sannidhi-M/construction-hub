STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
# When set, Medusa's sessions, event bus, workflow engine and locking use
# Redis too (medusa-config.ts); unset, they fall back to in-memory.
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# How phone OTPs are sent/checked: "server" (default — we generate the code and
# text it via MSG91 below) or "firebase" (Firebase Phone Auth; also needs the
# storefront's NEXT_PUBLIC_FIREBASE_* vars). Must match the storefront's
# NEXT_PUBLIC_PHONE_OTP_PROVIDER.
PHONE_OTP_PROVIDER=
FIREBASE_PROJECT_ID=

# MSG91 (phone/OTP login SMS) — leave unset in dev to log OTPs to the
# backend console instead of sending real SMS.
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_SENDER_ID=

# Minimum order value in INR. Leave unset (or 0) to disable — no minimum.
MIN_ORDER_VALUE_INR=

# Uploaded files (medusa-config.ts). Public link base for photos; production
# sets https://<api domain>/static. Private files (CSV exports/imports) live
# outside static/ so no URL reaches them; default ./private.
FILE_BACKEND_URL=
PRIVATE_UPLOAD_DIR=
