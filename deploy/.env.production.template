# Production settings for deploy/docker-compose.yml. Copy to deploy/.env on the
# server (never commit deploy/.env) and fill in. See docs/DEPLOYMENT.md.
# Generate secrets with: openssl rand -hex 32

# --- Domains (DNS A records for these, and www.SITE_DOMAIN, point at the server)
SITE_DOMAIN=constructmitra.in
API_DOMAIN=api.constructmitra.in

# --- Database (internal to the server; never exposed)
POSTGRES_USER=medusa
POSTGRES_PASSWORD=
POSTGRES_DB=constructmitra

# --- Backend secrets (new values; never reuse the development ones)
JWT_SECRET=
COOKIE_SECRET=

# --- Store rules
MIN_ORDER_VALUE_INR=0

# --- Phone login: "firebase" or "server" (MSG91). Used by both apps.
PHONE_OTP_PROVIDER=firebase
FIREBASE_PROJECT_ID=contructhub-ee101
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=
MSG91_AUTH_KEY=
MSG91_FLOW_ID=
MSG91_SENDER_ID=

# --- Storefront (compiled in at build time: change => redeploy)
# Publishable key: Medusa Admin -> Settings -> Publishable API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_UPI_VPA=
NEXT_PUBLIC_UPI_PAYEE_NAME=Construct Mitra
NEXT_PUBLIC_SITE_LEGAL_NAME=
NEXT_PUBLIC_SITE_GSTIN=
NEXT_PUBLIC_SITE_ADDRESS=
NEXT_PUBLIC_SITE_HOURS=

# --- Backups (deploy/backup.sh)
BACKUP_DIR=/var/backups/constructmitra
BACKUP_KEEP_DAYS=7
# Optional: rclone remote for the weekly off-server copy, e.g. gdrive:constructmitra-backups
RCLONE_REMOTE=
# Optional: healthchecks.io ping URL; you get an email if a nightly backup fails or doesn't run
HEALTHCHECK_PING_URL=
